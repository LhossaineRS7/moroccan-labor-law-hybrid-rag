{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "JurisMaroc IA - RAG Monitoring",
  "uid": "jurismaroc-rag",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Total RAG Requests",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rag_requests_total", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Out-of-Scope / Refusals (Je n'ai pas l'information)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rag_no_info_total", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "User Feedback (👍 vs 👎)",
      "type": "barchart",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rag_feedback_total", "legendFormat": "{{vote}}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Average Latency by Stage (Seconds)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rag_stage_duration_seconds_sum / rag_stage_duration_seconds_count",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ]
    }
  ]
}